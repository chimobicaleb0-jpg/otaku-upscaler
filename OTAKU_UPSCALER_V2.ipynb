    "# ================================\n",
    "# CELL 12 — AUTO AMV ARRANGEMENT\n",
    "# ================================\n",
    "def auto_amv_arrangement(video_path, mood='Peak'):\n",
    "    info = video_info(video_path)\n",
    "    duration = info['duration']\n    "\n",
    "    if mood.lower() == 'dark':\n",
    "        arrangement = [\n",
    "            {'section':'Intro','start':0,'end':min(3,duration),'effect':'fade + dark CC'},\n",
    "            {'section':'Build','start':min(3,duration),'end':min(7,duration),'effect':'slow zoom + blur'},\n",
    "            {'section':'Drop','start':min(7,duration),'end':min(15,duration),'effect':'impact + shake'},\n",
    "            {'section':'Outro','start':max(0,duration-3),'end':duration,'effect':'fade out'}\n",
    "        ]\n",
    "    elif mood.lower() == 'sad':\n",
    "        arrangement = [\n",
    "            {'section':'Intro','start':0,'end':min(4,duration),'effect':'soft blur + desaturation'},\n",
    "            {'section':'Emotion','start':min(4,duration),'end':min(10,duration),'effect':'slow zoom + aesthetic CC'},\n",
    "            {'section':'Climax','start':min(10,duration),'end':max(10,duration-2),'effect':'controlled shake'},\n",
    "            {'section':'Outro','start':max(0,duration-2),'end':duration,'effect':'fade'}\n",
    "        ]\n",
    "    else:\n",
    "        arrangement = [\n",
    "            {'section':'Hook','start':0,'end':min(2.5,duration),'effect':'fast zoom + impact text'},\n",
    "            {'section':'Build','start':min(2.5,duration),'end':min(6,duration),'effect':'velocity + glow'},\n",
    "            {'section':'Drop','start':min(6,duration),'end':min(14,duration),'effect':'shake + flash + impact CC'},\n",
    "            {'section':'Climax','start':min(14,duration),'end':max(14,duration-2),'effect':'camera push + glow'},\n",
    "            {'section':'Outro','start':max(0,duration-2),'end':duration,'effect':'fade'}\n",
    "        ]\n    \n    "    return arrangement\n\nprint('Auto AMV arrangement engine ready.')\n"
   ]
  },
