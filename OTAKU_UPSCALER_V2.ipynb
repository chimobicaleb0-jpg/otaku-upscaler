    "# ================================\n",
    "# CELL 10 — 60 FPS / FRAME TOOL\n",
    "# ================================\n",
    "def convert_to_60fps(input_video, output_video):\n    "    cmd = [\n    "        'ffmpeg','-y','-i',input_video,\n    "        '-vf','minterpolate=fps=60:mi_mode=mci:mc_mode=aobmc:me_mode=bidir',\n    "        '-c:v','libx264','-preset','medium','-crf','18',\n    "        '-c:a','aac','-b:a','192k','-shortest',output_video\n    "    ]\n    "    subprocess.run(cmd, check=True)\n    "    return output_video\n\nprint('60 FPS engine ready.')\n"
   ]
