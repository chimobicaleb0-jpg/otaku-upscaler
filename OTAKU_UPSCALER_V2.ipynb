    "# ================================\n",
    "# CELL 7 — OTAKU ANIME CC ENGINE\n",
    "# ================================\n",
    "CC_PRESETS = {\n",
    "    'Clean Anime': {\n",
    "        'brightness': 0,\n",
    "        'contrast': 8,\n",
    "        'saturation': 10,\n",
    "        'sharpness': 8,\n",
    "        'gamma': 1.0,\n    "        'blur': 0\n",
    "    },\n    "    'Dark Anime': {\n    "        'brightness': -8,\n    "        'contrast': 18,\n    "        'saturation': -4,\n    "        'sharpness': 10,\n    "        'gamma': 0.92,\n    "        'blur': 0\n    "    },\n    "    'Sad / Aesthetic': {\n    "        'brightness': 4,\n    "        'contrast': -2,\n    "        'saturation': -18,\n    "        'sharpness': 4,\n    "        'gamma': 1.04,\n    "        'blur': 0.5\n    "    },\n    "    'Fight / Impact': {\n    "        'brightness': 0,\n    "        'contrast': 25,\n    "        'saturation': 15,\n    "        'sharpness': 18,\n    "        'gamma': 0.96,\n    "        'blur': 0\n    "    },\n    "    'Manga B&W': {\n    "        'brightness': 0,\n    "        'contrast': 30,\n    "        'saturation': -100,\n    "        'sharpness': 20,\n    "        'gamma': 1.0,\n    "        'blur': 0\n    "    },\n    "    'Manga Blue': {\n    "        'brightness': -2,\n    "        'contrast': 20,\n    "        'saturation': 12,\n    "        'sharpness': 14,\n    "        'gamma': 0.96,\n    "        'tint': 'blue'\n    "    },\n    "    'Manga Green': {\n    "        'brightness': -2,\n    "        'contrast': 20,\n    "        'saturation': 12,\n    "        'sharpness': 14,\n    "        'gamma': 0.96,\n    "        'tint': 'green'\n    "    }\n    }\n\n    def apply_cc(frame, preset='Clean Anime', intensity=1.0):\n    "    cfg = CC_PRESETS.get(preset, CC_PRESETS['Clean Anime'])\n    "    img = frame.astype(np.float32) / 255.0\n    "\n    "    img = np.clip((img - 0.5) * (1 + cfg['contrast'] / 100.0) + 0.5, 0, 1)\n    "    img = np.clip(img + cfg['brightness'] / 255.0, 0, 1)\n    "\n    "    hsv = cv2.cvtColor((img * 255).astype(np.uint8), cv2.COLOR_BGR2HSV).astype(np.float32)\n    "    hsv[:, :, 1] *= max(0, 1 + cfg['saturation'] / 100.0)\n    "    hsv[:, :, 1] = np.clip(hsv[:, :, 1], 0, 255)\n    "    img = cv2.cvtColor(hsv.astype(np.uint8), cv2.COLOR_HSV2BGR).astype(np.float32) / 255.0\n    "\n    "    gamma = cfg.get('gamma', 1.0)\n    "    img = np.power(np.clip(img, 0, 1), gamma)\n    "\n    "    if cfg.get('sharpness', 0) > 0:\n    "        amount = cfg['sharpness'] / 100.0\n    "        blur = cv2.GaussianBlur(img, (0, 0), 2)\n    "        img = np.clip(img + amount * (img - blur), 0, 1)\n    "\n    "    if cfg.get('blur', 0) > 0:\n    "        img = cv2.GaussianBlur(img, (0, 0), cfg['blur'])\n    "\n    "    return np.clip(img * 255, 0, 255).astype(np.uint8)\n"
   ]
  },
