    "# ================================\n",
    "# CELL 6 — IMAGE PROCESSING\n",
    "# ================================\n",
    "def upscale_image(input_path, output_path, model='Anime 6B', scale=4):\n",
    "    upsampler = create_upscaler(model, scale)\n",
    "    img = cv2.imread(input_path, cv2.IMREAD_COLOR)\n",
    "\n",
    "    if img is None:\n",
    "        raise ValueError('Could not read image.')\n",
    "\n",
    "    output, _ = upsampler.enhance(img, outscale=scale)\n",
    "    cv2.imwrite(output_path, output)\n",
    "    return output_path\n",
    "\n",
    "def image_info(path):\n",
    "    img = cv2.imread(path)\n    "    if img is None:\n    "        return None\n    "    h, w = img.shape[:2]\n    "    return {'width': w, 'height': h}\n",
    "\n    print('Image engine ready.')\n"
   ]
  },
