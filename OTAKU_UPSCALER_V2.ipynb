    "# ================================\n",
    "# CELL 8 — VIDEO INFORMATION\n",
    "# ================================\n",
    "def video_info(path):\n    "    cap = cv2.VideoCapture(path)\n    "    if not cap.isOpened():\n    "        raise ValueError('Could not open video.')\n    "\n    "    fps = cap.get(cv2.CAP_PROP_FPS)\n    "    frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n    "    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n    "    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n    "    duration = frames / fps if fps else 0\n    "    cap.release()\n    "\n    "    return {\n    "        'fps': fps,\n    "        'frames': frames,\n    "        'width': width,\n    "        'height': height,\n    "        'duration': duration\n    "    }\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ================================\n",
    "# CELL 9 — VIDEO UPSCALER\n",
    "# ================================\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "def extract_audio(video, audio_path):\n",
    "    cmd = [\n    "        'ffmpeg','-y','-i',video,\n    "        '-vn','-acodec','copy',audio_path\n    "    ]\n    "    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "    return os.path.exists(audio_path)\n",
    "\n",
    "def process_video(input_video, output_video, model='Anime 6B', scale=2,\n    "                  cc='Clean Anime', target_fps=None):\n",
    "    info = video_info(input_video)\n    "    print('Input:', info)\n",
    "\n    "    temp_video = os.path.join(WORK, 'temp_video.mp4')\n    "    audio_path = os.path.join(WORK, 'audio.m4a')\n    "\n    "    extract_audio(input_video, audio_path)\n    "\n    "    cap = cv2.VideoCapture(input_video)\n    "    input_fps = info['fps']\n    "    fps = target_fps if target_fps else input_fps\n    "    width = int(info['width'] * scale)\n    "    height = int(info['height'] * scale)\n    "\n    "    fourcc = cv2.VideoWriter_fourcc(*'mp4v')\n    "    writer = cv2.VideoWriter(temp_video, fourcc, fps, (width, height))\n    "\n    "    upsampler = create_upscaler(model, scale)\n    "    total = info['frames']\n    "\n    "    for _ in tqdm(range(total), desc='Upscaling video'):\n    "        ok, frame = cap.read()\n    "        if not ok:\n    "            break\n    "\n    "        result, _ = upsampler.enhance(frame, outscale=scale)\n    "        result = apply_cc(result, cc)\n    "        result = cv2.resize(result, (width, height), interpolation=cv2.INTER_LANCZOS4)\n    "        writer.write(result)\n    "\n    "    cap.release()\n    "    writer.release()\n    "\n    "    # Optional FPS conversion using FFmpeg minterpolate.\n    "    fps_video = temp_video\n    "    if target_fps and target_fps > input_fps:\n    "        fps_video = os.path.join(WORK, 'fps_video.mp4')\n    "        cmd = [\n    "            'ffmpeg','-y','-i',temp_video,\n    "            '-vf',f'minterpolate=fps={target_fps}:mi_mode=mci:mc_mode=aobmc:me_mode=bidir',\n    "            '-c:v','libx264','-preset','medium','-crf','18',fps_video\n    "        ]\n    "        subprocess.run(cmd, check=True)\n    "\n    "    if os.path.exists(audio_path):\n    "        cmd = [\n    "            'ffmpeg','-y','-i',fps_video,'-i',audio_path,\n    "            '-map','0:v:0','-map','1:a:0?',\n    "            '-c:v','libx264','-crf','18','-preset','medium',\n    "            '-c:a','aac','-b:a','192k','-shortest',output_video\n    "        ]\n    "    else:\n    "        cmd = [\n    "            'ffmpeg','-y','-i',fps_video,\n    "            '-c:v','libx264','-crf','18','-preset','medium',output_video\n    "        ]\n    "\n    "    subprocess.run(cmd, check=True)\n    "    return output_video\n"
   ]
  },
